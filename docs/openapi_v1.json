  "components": {
    "schemas": {
      "AnalysisRequestBody": {
        "properties": {
          "competitions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Competitions"
          },
          "seasons": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Seasons"
          },
          "teams": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Teams"
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue"
          },
          "form_window": {
            "type": "integer",
            "title": "Form Window",
            "default": 5
          }
        },
        "type": "object",
        "title": "AnalysisRequestBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "read_only": {
            "type": "boolean",
            "title": "Read Only"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "read_only"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
