# Copy to .env and fill in. Never commit real values.
FOOTBALL_POSTGRES_DSN=postgresql://user:password@host:5432/postgres?sslmode=require
FOOTBALL_POSTGRES_SCHEMA=football_live
FOOTBALL_API_READ_BACKEND=postgres
# Optional: failure alerts via https://ntfy.sh (subscribe to the same topic in the ntfy app)
NTFY_TOPIC=football-analysis-<random>
# Optional: current squads for the featured clubs (free key from https://www.api-football.com,
# 100 requests/day; the full refresh uses about 12 and stops at API_FOOTBALL_RESERVE remaining)
API_FOOTBALL_KEY=
API_FOOTBALL_RESERVE=20
# POST /api/v1/refresh accepts loopback callers only unless this is set; then it needs the
# same value in the X-Admin-Token header (required when the API is reachable from the network)
FOOTBALL_ADMIN_TOKEN=
# LightGBM device: auto (default) trains on an NVIDIA GPU when one is detected and this LightGBM
# build supports it (CUDA, else OpenCL), otherwise CPU. Force with cpu | gpu | cuda.
# FOOTBALL_ML_DEVICE=auto
