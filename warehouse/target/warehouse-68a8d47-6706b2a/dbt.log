{"data": {"conn_name": "test.football_warehouse.assert_one_match_per_team_per_day", "node_info": {"materialized": "test", "meta": {}, "node_checksum": "10d3dc7095e11f4a1532c6b300b2f3e3369d863faea39b60a7fc2c7f2884d86b", "node_finished_at": "", "node_name": "assert_one_match_per_team_per_day", "node_path": "assert_one_match_per_team_per_day.sql", "node_relation": {"alias": "assert_one_match_per_team_per_day", "database": "football", "relation_name": "", "schema": "dbt_test__audit"}, "node_started_at": "2026-10-03T02:27:06.569534", "node_status": "executing", "resource_type": "test", "unique_id": "test.football_warehouse.assert_one_match_per_team_per_day"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"node_id\": \"test.football_warehouse.assert_one_match_per_team_per_day\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- A team playing twice on one date would let same-day results leak into features.\nwith appearances as (\n    select match_date, home_team as team from \"football\".\"ml\".\"ml_match_features\"\n    union all\n    select match_date, away_team from \"football\".\"ml\".\"ml_match_features\"\n)\nselect match_date, team, count(*) from appearances group by all having count(*) > 1\n  \n  \n      \n    ) dbt_internal_test"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9632dbb7-12ee-4a73-b9b5-cdb3bcb38f16", "level": "debug", "msg": "On test.football_warehouse.assert_one_match_per_team_per_day: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"node_id\": \"test.football_warehouse.assert_one_match_per_team_per_day\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- A team playing twice on one date would let same-day results leak into features.\nwith appearances as (\n    select match_date, home_team as team from \"football\".\"ml\".\"ml_match_features\"\n    union all\n    select match_date, away_team from \"football\".\"ml\".\"ml_match_features\"\n)\nselect match_date, team, count(*) from appearances group by all having count(*) > 1\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 105607, "thread": "Thread-1 (worker)", "ts": "2026-10-03T02:27:06.580826Z"}}
