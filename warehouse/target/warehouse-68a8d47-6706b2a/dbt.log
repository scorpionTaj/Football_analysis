{"data": {"conn_name": "test.football_warehouse.assert_complete_double_round_robin", "node_info": {"materialized": "test", "meta": {}, "node_checksum": "548b8b1564c5fa1565daa9aa8f3755b78f6091b0a722ddf30b2fa9c2822a4217", "node_finished_at": "", "node_name": "assert_complete_double_round_robin", "node_path": "assert_complete_double_round_robin.sql", "node_relation": {"alias": "assert_complete_double_round_robin", "database": "football", "relation_name": "", "schema": "dbt_test__audit"}, "node_started_at": "2026-10-03T02:26:24.135281", "node_status": "executing", "resource_type": "test", "unique_id": "test.football_warehouse.assert_complete_double_round_robin"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"node_id\": \"test.football_warehouse.assert_complete_double_round_robin\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- Completed top-five seasons must contain every home/away pairing exactly once\n-- Known exception: Ligue 1 2019/20 was abandoned in March 2020 (COVID-19) at 279 matches.\nwith completed as (\n    select league, season, count(*) as matches,\n           count(distinct home_team) as teams\n    from \"football\".\"marts\".\"fct_match\"\n    where league in ('E0', 'SP1', 'D1', 'I1', 'F1')\n      and season < (select max(season) from \"football\".\"marts\".\"fct_match\")\n      and not (league = 'F1' and season = 2019)\n    group by all\n)\nselect * from completed where matches <> teams * (teams - 1)\n  \n  \n      \n    ) dbt_internal_test"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9632dbb7-12ee-4a73-b9b5-cdb3bcb38f16", "level": "debug", "msg": "On test.football_warehouse.assert_complete_double_round_robin: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"node_id\": \"test.football_warehouse.assert_complete_double_round_robin\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- Completed top-five seasons must contain every home/away pairing exactly once\n-- Known exception: Ligue 1 2019/20 was abandoned in March 2020 (COVID-19) at 279 matches.\nwith completed as (\n    select league, season, count(*) as matches,\n           count(distinct home_team) as teams\n    from \"football\".\"marts\".\"fct_match\"\n    where league in ('E0', 'SP1', 'D1', 'I1', 'F1')\n      and season < (select max(season) from \"football\".\"marts\".\"fct_match\")\n      and not (league = 'F1' and season = 2019)\n    group by all\n)\nselect * from completed where matches <> teams * (teams - 1)\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 105607, "thread": "Thread-1 (worker)", "ts": "2026-10-03T02:26:24.147845Z"}}
