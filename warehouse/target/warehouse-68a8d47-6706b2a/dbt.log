{"data": {"conn_name": "list_football_reference", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"connection_name\": \"list_football_reference\"} */\nselect\n      'football' as database,\n      table_name as name,\n      table_schema as schema,\n      CASE table_type\n        WHEN 'BASE TABLE' THEN 'table'\n        WHEN 'VIEW' THEN 'view'\n        WHEN 'LOCAL TEMPORARY' THEN 'table'\n        END as type\n    from system.information_schema.tables\n    where lower(table_schema) = 'reference'\n    and lower(table_catalog) = 'football'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9632dbb7-12ee-4a73-b9b5-cdb3bcb38f16", "level": "debug", "msg": "On list_football_reference: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"connection_name\": \"list_football_reference\"} */\nselect\n      'football' as database,\n      table_name as name,\n      table_schema as schema,\n      CASE table_type\n        WHEN 'BASE TABLE' THEN 'table'\n        WHEN 'VIEW' THEN 'view'\n        WHEN 'LOCAL TEMPORARY' THEN 'table'\n        END as type\n    from system.information_schema.tables\n    where lower(table_schema) = 'reference'\n    and lower(table_catalog) = 'football'\n  ", "name": "SQLQuery", "pid": 105607, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-10-03T02:26:17.797599Z"}}
