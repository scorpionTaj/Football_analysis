{"data": {"conn_name": "model.football_warehouse.stg_app__fixtures", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "60b933fcfa244b3c8ba3c5078b7739ce402d7e72cb5caa53645292680836aa02", "node_finished_at": "", "node_name": "stg_app__fixtures", "node_path": "staging/stg_app__fixtures.sql", "node_relation": {"alias": "stg_app__fixtures", "database": "football", "relation_name": "\"football\".\"staging\".\"stg_app__fixtures\"", "schema": "staging"}, "node_started_at": "2026-10-03T02:26:17.853884", "node_status": "executing", "resource_type": "model", "unique_id": "model.football_warehouse.stg_app__fixtures"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"node_id\": \"model.football_warehouse.stg_app__fixtures\"} */\n\n  \n  create view \"football\".\"staging\".\"stg_app__fixtures__dbt_tmp\" as (\n    -- Upcoming domestic fixtures from every provider; names are reconciled downstream\n-- (football_analysis.teams.team_key) because providers spell clubs differently.\nselect league, season, match_date, home_team, away_team, event_kind, source, fetched_at\nfrom \"football\".\"main\".\"recent_events\"\nwhere event_kind in ('next', 'fixture') and match_date >= current_date\n  );\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9632dbb7-12ee-4a73-b9b5-cdb3bcb38f16", "level": "debug", "msg": "On model.football_warehouse.stg_app__fixtures: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"football_warehouse\", \"target_name\": \"dev\", \"node_id\": \"model.football_warehouse.stg_app__fixtures\"} */\n\n  \n  create view \"football\".\"staging\".\"stg_app__fixtures__dbt_tmp\" as (\n    -- Upcoming domestic fixtures from every provider; names are reconciled downstream\n-- (football_analysis.teams.team_key) because providers spell clubs differently.\nselect league, season, match_date, home_team, away_team, event_kind, source, fetched_at\nfrom \"football\".\"main\".\"recent_events\"\nwhere event_kind in ('next', 'fixture') and match_date >= current_date\n  );\n", "name": "SQLQuery", "pid": 105607, "thread": "Thread-1 (worker)", "ts": "2026-10-03T02:26:17.896129Z"}}
