  create view "football"."staging"."stg_app__fixtures__dbt_tmp" as (
    -- Upcoming domestic fixtures; a full-season schedule row beats a "next event" row.
select league, season, match_date, home_team, away_team
from "football"."main"."recent_events"
where event_kind in ('next', 'fixture') and match_date >= current_date
qualify row_number() over (
    partition by league, season, home_team, away_team
    order by case event_kind when 'fixture' then 0 else 1 end, fetched_at desc
) = 1
  );

